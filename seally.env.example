## 将本文件中的配置合并到 Seafile 部署目录原有的 .env。
## 不要直接覆盖官方 .env，也不要把真实 .env 提交到 Git。

## 在原值末尾追加 seally.yml；保留原有的其他组件。
## Seafile 12 CE/Pro、Seafile 13 CE 示例：
# COMPOSE_FILE='seafile-server.yml,caddy.yml,seadoc.yml,seally.yml'
## Seafile 13 Pro + Elasticsearch 示例：
# COMPOSE_FILE='seafile-server.yml,caddy.yml,seadoc.yml,elasticsearch.yml,seally.yml'

## 必填：填写发布页中的完整版本标签或 digest，禁止使用 latest。
## 示例格式：ghcr.io/ysf002-project/seally:YYYY.MM.PATCH
SEALLY_IMAGE=

SM_RUN_MODE=release

## 必填：Seafile 12 填 memcached，Seafile 13 填 redis。
CACHE_PROVIDER=

## Seafile 13 默认值；使用 Seafile 12 时不会连接这组配置。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

## Seafile 12 默认值；使用 Seafile 13 时不会连接这组配置。
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

## Seally 独立密钥：执行 openssl rand -hex 32 生成。
## 上线后不可更换；不要与 JWT_PRIVATE_KEY 共用。
SM_SESSION_SECRET=
SM_SESSION_TTL=23h

## 通常无需修改，使用 seafile-net 内的官方服务名直连。
SM_SEAFILE_INNER_URL=http://seafile:80

## 可选网盘应用配置。
ONEDRIVE_CLIENT_ID=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=https://seafile.example.com/mate/api/v1/drives/oauth/callback
DROPBOX_CLIENT_ID=

## 百度应用目录必须与百度开放平台中的应用名称匹配。
BAIDU_APP_ROOT=/apps/seally
